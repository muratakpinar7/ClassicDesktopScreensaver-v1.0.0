<Window x:Class="ClassicDesktopScreensaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classic Desktop Screensaver"
        Width="720"
        Height="860"
        MinWidth="650"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" Margin="4,0,4,4"/>
            <TextBlock x:Name="SubtitleText" TextWrapping="Wrap" Foreground="DimGray" Margin="4,0,4,14"/>

            <GroupBox x:Name="ScreenSaverGroup" Margin="0,5">
                <StackPanel Margin="10">
                    <TextBlock x:Name="WindowsSelectedSaverLabel" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WindowsSaverPathText" TextWrapping="Wrap" Margin="4,5,4,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <CheckBox x:Name="UseCustomSaverCheckBox" VerticalAlignment="Center"
                                  Checked="CustomSaverSelection_Changed"
                                  Unchecked="CustomSaverSelection_Changed"/>
                        <Button x:Name="TestCustomSaverButton" Margin="12,0,0,0"
                                VerticalAlignment="Center" Click="TestCustomSaver_Click"/>
                    </StackPanel>
                    <DockPanel>
                        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Click="BrowseScreenSaver_Click"/>
                        <TextBox x:Name="CustomSaverPathText" IsReadOnly="True"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Button x:Name="OpenWindowsSaverSettingsButton" Click="OpenWindowsSaverSettings_Click"/>
                        <Button x:Name="StartNowButton" Click="StartNow_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="AutoGroup" Margin="0,5">
                <StackPanel Margin="10">
                    <CheckBox x:Name="AutoEnabledCheckBox"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StartAfterLabel" Width="190" VerticalAlignment="Center"/>
                        <TextBox x:Name="SaverMinutesTextBox" Width="70"/>
                        <TextBlock x:Name="MinutesAfterLabel" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox x:Name="LockEnabledCheckBox"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LockComputerLabel" Width="190" VerticalAlignment="Center"/>
                        <TextBox x:Name="LockMinutesTextBox" Width="70"/>
                        <TextBlock x:Name="MinutesLockLabel" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="GuardsGroup" Margin="0,5">
                <StackPanel Margin="10">
                    <CheckBox x:Name="MediaGuardCheckBox"/>
                    <CheckBox x:Name="FullscreenGuardCheckBox"/>
                    <CheckBox x:Name="LockGuardCheckBox"/>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="HotCornerGroup" Margin="0,5">
                <StackPanel Margin="10">
                    <CheckBox x:Name="HotCornerEnabledCheckBox"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CornerLabel" Width="190" VerticalAlignment="Center"/>
                        <ComboBox x:Name="HotCornerComboBox" Width="180">
                            <ComboBoxItem Tag="TopLeft"/>
                            <ComboBoxItem Tag="TopRight"/>
                            <ComboBoxItem Tag="BottomLeft"/>
                            <ComboBoxItem Tag="BottomRight"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CornerDelayLabel" Width="190" VerticalAlignment="Center"/>
                        <TextBox x:Name="HotCornerDelayTextBox" Width="70"/>
                        <TextBlock Text="ms" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="HotkeysGroup" Margin="0,5">
                <StackPanel Margin="10">
                    <TextBlock x:Name="HotkeyHelpText" TextWrapping="Wrap" Foreground="DimGray" Margin="4,0,4,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="StartSaverLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="StartScreenSaverHotkeyEnabledCheckBox"
                                  Grid.Row="0" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Checked="ShortcutCheckBox_Changed"
                                  Unchecked="ShortcutCheckBox_Changed"/>
                        <TextBox Grid.Row="0" Grid.Column="2" x:Name="StartHotkeyTextBox" IsReadOnly="True" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                        <TextBlock x:Name="ToggleSaverLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ToggleScreenSaverHotkeyEnabledCheckBox"
                                  Grid.Row="1" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Checked="ShortcutCheckBox_Changed"
                                  Unchecked="ShortcutCheckBox_Changed"/>
                        <TextBox Grid.Row="1" Grid.Column="2" x:Name="ToggleHotkeyTextBox" IsReadOnly="True" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                        <TextBlock x:Name="SleepStandbyLabel" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="SleepHotkeyEnabledCheckBox"
                                  Grid.Row="2" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Checked="ShortcutCheckBox_Changed"
                                  Unchecked="ShortcutCheckBox_Changed"/>
                        <TextBox Grid.Row="2" Grid.Column="2" x:Name="SleepHotkeyTextBox" IsReadOnly="True" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                        <TextBlock x:Name="HibernateLabel" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="HibernateHotkeyEnabledCheckBox"
                                  Grid.Row="3" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Checked="ShortcutCheckBox_Changed"
                                  Unchecked="ShortcutCheckBox_Changed"/>
                        <TextBox Grid.Row="3" Grid.Column="2" x:Name="HibernateHotkeyTextBox" IsReadOnly="True" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                    </Grid>
                    <Button x:Name="RestoreHotkeysButton" HorizontalAlignment="Left" Click="RestoreHotkeys_Click"/>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="BehaviorGroup" Margin="0,5">
                <StackPanel Margin="10">
                    <CheckBox x:Name="NotificationsCheckBox"/>
                    <CheckBox x:Name="TrayIconCheckBox"/>
                    <CheckBox x:Name="StartWithWindowsCheckBox"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LanguageLabel" Width="190" VerticalAlignment="Center"/>
                        <ComboBox x:Name="LanguageComboBox" Width="230" SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem Tag="Auto"/>
                            <ComboBoxItem Tag="Turkish"/>
                            <ComboBoxItem Tag="English"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <Border Background="#FFF7F7F7" BorderBrush="#FFE0E0E0" BorderThickness="1"
                    CornerRadius="5" Padding="10" Margin="0,8">
                <TextBlock x:Name="RegistryNoteText" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,12">
                <Button x:Name="RestoreDefaultsButton" MinWidth="205" Click="RestoreDefaults_Click"/>
                <Button x:Name="AboutButton" MinWidth="110" Click="About_Click"/>
                <Button x:Name="HideButton" MinWidth="160" Click="Hide_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
