<Window x:Class="ClassicDesktopScreensaver.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Width="540" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Image Source="/Assets/AppIcon.png" Width="82" Height="82" Margin="0,0,18,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Margin="0,6,0,0" Foreground="DimGray"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="MinimumWindowsText" TextWrapping="Wrap" Margin="0,5"/>
            <TextBlock x:Name="AIText" TextWrapping="Wrap" Margin="0,5"/>
            <TextBlock x:Name="LicenseText" TextWrapping="Wrap" Margin="0,5"/>
            <TextBlock x:Name="PrivacyText" TextWrapping="Wrap" Margin="0,5"/>
        </StackPanel>
        <Button Grid.Row="2" x:Name="CloseButton" Width="100" HorizontalAlignment="Right" Click="Close_Click"/>
    </Grid>
</Window>
