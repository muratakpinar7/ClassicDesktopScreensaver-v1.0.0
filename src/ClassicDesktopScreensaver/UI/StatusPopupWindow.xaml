<Window x:Class="ClassicDesktopScreensaver.UI.StatusPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        MinHeight="74"
        SizeToContent="Height"
        UseLayoutRounding="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False">
    <Border Background="#E61E1E1E"
            CornerRadius="8"
            Padding="16,14"
            BorderBrush="#40FFFFFF"
            BorderThickness="1">
        <TextBlock x:Name="MessageText"
                   Foreground="White"
                   FontSize="14"
                   LineHeight="20"
                   LineStackingStrategy="BlockLineHeight"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
    </Border>
</Window>
